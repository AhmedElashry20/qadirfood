# ── قاعدة البيانات ──
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery
POSTGRES_DB=delivery
DATABASE_URL="postgresql://delivery:delivery@localhost:5433/delivery?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── API ──
PORT=3000
NODE_ENV=development
JWT_SECRET="غيّر-ده-بسر-عشوائي-طويل"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="غيّر-ده-كمان"
JWT_REFRESH_EXPIRES_IN="30d"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ── قواعد العمل ──
VAT_PERCENT=15
DEFAULT_COMMISSION_PERCENT=15
DEFAULT_DELIVERY_FEE=10
# ── نقاط الولاء والإحالة ──
# مطفي افتراضياً — التفعيل بيبدأ الكسب والاستبدال فوراً.
LOYALTY_ENABLED=0
LOYALTY_POINTS_PER_SAR=1
LOYALTY_POINT_VALUE_SAR=0.05
LOYALTY_REFERRAL_POINTS=500

# ── المسافات والمسارات ──
# فاضي أو 'none' = تقدير هوائي مضروب في معامل التفاف (١.٣).
# 'osrm' = مسافة طريق حقيقية. السيرفر العام مش للإنتاج — استضف نسختك.
ROUTING_PROVIDER=
ROUTING_OSRM_URL=
ROUTING_TIMEOUT_MS=2500

CAPTAIN_SEARCH_RADIUS_KM=7
TRIP_OFFER_TIMEOUT_SECONDS=30
NEW_ORDER_ALERT_TIMEOUT_SECONDS=180   # لو المطعم ما ردّش، ينبّه الأدمن

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=""

# ── Firebase (FCM) ──
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ── بوابة الدفع ──
# "moyasar" = دفع إلكتروني حقيقي · فاضي/غير موجود = sandbox تطوير (مش بيحرّك فلوس).
PAYMENT_PROVIDER=""
# دومين الـ API العام (HTTPS) — بيتحط في رابط رجوع ميسّر بعد الدفع.
PUBLIC_API_URL=""

# ── Moyasar (مدى / Apple Pay / بطاقات) ──
# secret key (sk_...) للسيرفر · publishable (pk_...) للتطبيق · webhook secret من لوحة ميسّر.
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# ── التحقق بالوجه (اشتراط الهيئة) ──
AWS_REGION="me-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── SMS / OTP ──
SMS_PROVIDER="unifonic"
SMS_API_KEY=""

# سر الـ webhook بتاع بوابة الدفع — لو فاضي الـ endpoint بيرفض كل حاجة.
PAYMENTS_WEBHOOK_SECRET=""

# ── ZATCA ──
ZATCA_SELLER_NAME="قادر فود للتوصيل"
ZATCA_VAT_NUMBER="300000000000003"

REFUND_APPROVAL_THRESHOLD=100

# ── هيئة النقل (TGA) ──
# رقم منشأة المنصة في الهيئة. فاضي = اللوحة بتعرض تنبيه إن الربط مش متظبّط،
# والتحقّق بيفضل يدوي (مافيش ربط API مباشر لحد ما يتوفّر اعتماد من الهيئة).
TGA_ESTABLISHMENT_NUMBER=
# 1 = التوزيع بيستبعد أي كابتن بطاقة توصيله مش موثّقة أو منتهية. مطفي افتراضياً
# عشان ما يكسرش بيئة قبل ما البطاقات تتظبّط.
TGA_ENFORCE=0

# ── التحقق اليومي بالوجه ──
# 1 = المندوب لازم يعمل تحقّق وجه موثّق كل يوم قبل ما يشتغل (بدء وردية + توزيع).
# مطفي افتراضياً لحد ما تطبيق الكابتن يضيف شاشة السيلفي. المطابقة البيومترية
# الحقيقية محتاجة خدمة (AWS Rekognition/Azure Face) — الحالي stub واضح.
FACE_CHECK_ENFORCE=0

# ── محاكاة/عرض حيّ (تطوير بس، بتتعطّل في الإنتاج) ──
# LIVE_SIM: بيحرّك الكباتن الأونلاين على الخريطة.
LIVE_SIM=0
# DEMO_FLOW: بيسوق طلبات حقيقية عبر الخدمات (create→...→deliver) فالمنصة تبان حيّة.
DEMO_FLOW=0
