# ══════════════════════════════════════════════════════════════════════════
#  قادر فود — إعداد الإنتاج (انسخه لـ .env على سيرفر الإنتاج واملأ القيم)
#  ⚠️ فحص الإقلاع (main.ts) بيرفض السيرفر يقوم لو أي سرّ إلزامي ناقص أو ضعيف.
# ══════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# ── قاعدة البيانات والكاش (خدمات مُدارة أو من docker-compose.prod) ──
DATABASE_URL="postgresql://USER:PASSWORD@db:5432/qadirfood?schema=public"
REDIS_URL="redis://redis:6379"

# ── أسرار JWT — ولّد سرّين مختلفين قويين (مثلاً: openssl rand -base64 48) ──
JWT_SECRET="__ضع_سرّاً_عشوائياً_طويلاً_هنا__"
JWT_REFRESH_SECRET="__سرّ_مختلف_تماماً__"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── الدومين ──
# دومين اللوحة (مصدر مسموح للـ CORS). عدّة دومينات بفاصلة.
CORS_ORIGINS="https://admin.qadirfood.sa"
# دومين الـ API العام (HTTPS) — بيتحط في رابط رجوع بوابة الدفع.
PUBLIC_API_URL="https://api.qadirfood.sa"

# ── علوم العرض: لازم مقفولة في الإنتاج ──
DEMO_FLOW=0
LIVE_SIM=0
# OTP_DEV_ECHO: سيبها فاضية/مش موجودة — إظهار رمز OTP ممنوع في الإنتاج.
# ENABLE_SWAGGER: سيبها فاضية — توثيق Swagger مقفول في الإنتاج.

# ── قواعد العمل ──
VAT_PERCENT=15
DEFAULT_DELIVERY_FEE=15
REFUND_APPROVAL_THRESHOLD=100

# ── بوابة الدفع: ميسّر (Moyasar) ──
PAYMENT_PROVIDER="moyasar"
MOYASAR_SECRET_KEY="sk_live_..."         # من لوحة ميسّر
MOYASAR_PUBLISHABLE_KEY="pk_live_..."    # للتطبيق (اختياري للـ SDK)
MOYASAR_WEBHOOK_SECRET="__توكن_الـ webhook_من_لوحة_ميسّر__"

# ── مزوّد الرسائل (OTP حقيقي) ──
SMS_PROVIDER="unifonic"
SMS_API_KEY="__AppSid_من_Unifonic__"
SMS_SENDER_ID="QadirFood"

# ── إشعارات Push (Firebase FCM) — من ملف حساب الخدمة ──
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""   # بالأسطر مهرّبة \n

# ── بذرة الأدمن الأولى (npm run seed:prod) ──
ADMIN_EMAIL="admin@qadirfood.sa"
ADMIN_PHONE="05XXXXXXXX"
ADMIN_PASSWORD="__كلمة_مرور_قوية_للأدمن__"

# ── ZATCA (الفاتورة الضريبية) ──
ZATCA_SELLER_NAME="قادر فود للتوصيل"
ZATCA_VAT_NUMBER="3XXXXXXXXXXXXX3"

# ── التخزين السحابي (اختياري — بديل التخزين المحلي) ──
# AWS_REGION="me-south-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_BUCKET=""

# ── هيئة النقل / التحقق بالوجه (فعّلها لما تربط تكاملها) ──
# TGA_ENFORCE=1
# TGA_ESTABLISHMENT_NUMBER=""
# FACE_CHECK_ENFORCE=1
